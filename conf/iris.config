// SLURM / Singularity settings for nf-core/oncoanalyser 3.0.0 on IRIS.
// Pass with: -c conf/iris.config
// Resources and infrastructure only; no pipeline parameters here.

process {
    executor = 'slurm'

    // Pick the partition from the time each task requests (task.time),
    // not from how long it actually runs. Re-evaluated on every retry,
    // so a task whose time grows with task.attempt can move partitions.
    // Walltime limits: cpushort 2h, cmobic_short 3h, cmobic_cpu 7 days.
    queue = {
        if( !task.time )
            return 'cmobic_cpu'
        if( task.time <= 2.h )
            return 'cpushort,cmobic_short'
        if( task.time <= 3.h )
            return 'cmobic_short'
        return 'cmobic_cpu'
    }

    // QOS: cmobic_cpu and cmobic_short allow 'normal' (the default) and
    // 'priority'. 'priority' puts our jobs ahead of 'normal' jobs waiting
    // for those partitions. It has no limits and does not change
    // preemption, which is by partition tier. cpushort allows only
    // 'normal', and SLURM rejects a job listed for 'cpushort,cmobic_short'
    // with --qos=priority (EnforcePartLimits=ALL), so no QOS when the
    // queue includes cpushort. null = no cluster options. If the queue
    // rule above changes, check this one.
    clusterOptions = { task.queue.contains('cpushort') ? null : '--qos=priority' }

    // cpus and memory cap, so a task fits on any node of cpushort,
    // cmobic_short and cmobic_cpu. EnforcePartLimits=ALL: a job listed
    // for several partitions must fit the limits of each one.
    // - 56-CPU nodes: SLURM reserves 4 cores (CoreSpecCount), so 52 CPUs
    //   are allocatable; cpushort also sets MaxCPUsPerNode=52.
    // - cpushort sets MaxMemPerNode=998557 MB; 975.GB is 998400 MB.
    // time cap = cmobic_cpu walltime limit
    resourceLimits = [ cpus: 52, memory: 975.GB, time: 7.d ]

    // PURPLE loads the whole somatic VCF into the Java heap. For a
    // tumor-only sample that VCF is large (611 MB compressed in one
    // case) and the default 36 GB fails with OutOfMemoryError. Java
    // exits 1 on that error, which errorStrategy retries only once: if
    // this is too small, raise the number here.
    withName: 'PURPLE' {
        memory = { 96.GB * task.attempt }
    }

    // ESVEE needs far more memory for samples with many chimeric reads.
    // Its prep step holds 70 GB or more of reads in the Java heap, then
    // sorts the prep BAM with sambamba in the same job, while the module
    // sets the heap to 95% of the request. On the default 72 GB such
    // samples ran out of heap (exit 1) or were killed at the sort (exit
    // 137); one with 935 M prep BAM records was also killed with
    // 144 GB and passed with 216 GB. 24 CPUs ran prep 1.4 to 2 times
    // faster than 12, and 36 no faster than 24, so cpus does not grow
    // with task.attempt.
    withName: '.*:ESVEE_CALLING:ESVEE' {
        cpus   = 24
        memory = { 216.GB * task.attempt }
    }

    // SAGE somatic kept 97% of the default 12 CPUs busy and ran up to
    // 5.3 h; once ESVEE has enough memory it is the longest step for the
    // slowest samples. Start at the pipeline's own attempt-2 size.
    withName: '.*:SAGE_CALLING:SAGE_SOMATIC' {
        cpus   = { 24     * task.attempt }
        memory = { 144.GB * task.attempt }
    }

    // WiGiTS tools exit 1 on real failures, but Java also exits 1 on
    // OutOfMemoryError (PURPLE and ESVEE each stopped a run this way).
    // Retry every failure once, with more memory (task.attempt); after
    // that, retry only exit codes other than 1 (OOM kill, walltime,
    // node problems).
    errorStrategy = { task.exitStatus != 1 || task.attempt == 1 ? 'retry' : 'finish' }
    maxRetries    = 3

    // Never write to the node's /tmp. Each task (SLURM job) gets its own
    // folder on node-local /localscratch. Runs on the node before the
    // container starts. The exports replace any TMPDIR etc. inherited
    // from the head job's environment (sbatch passes it to tasks).
    // Single quotes: $SLURM_JOB_ID is expanded by the shell in the job.
    // No automatic cleanup; folders are left for manual removal.
    beforeScript = '''
        NXF_LOCAL_TMP=/localscratch/soccin/oncoanalyser/$SLURM_JOB_ID
        mkdir -p $NXF_LOCAL_TMP
        export TMPDIR=$NXF_LOCAL_TMP
        export SINGULARITY_TMPDIR=$NXF_LOCAL_TMP
        export APPTAINER_TMPDIR=$NXF_LOCAL_TMP
    '''
}

// Do not set cpus or memory here: since Nextflow 26.10 they also cap
// SLURM tasks.
// queueSize: at 50, alignment (one 12-CPU task per lane pair) used
// about half of cmobic_cpu, which fits about 91 such tasks (1,188
// allocatable CPUs). 200 fills it; the rest wait in SLURM with QOS
// priority and start as slots free. Partition policy: user decision
// (2026-11-18).
executor {
    queueSize       = 200
    submitRateLimit = '10 sec'
}

// Must match NXF_SINGULARITY_CACHEDIR in conf/ENV.sh.
singularity {
    enabled     = true
    autoMounts  = true
    cacheDir    = '/scratch/core001/bic/socci/singularity-cache'
    pullTimeout = '2h'
    // Task folder /localscratch/soccin/oncoanalyser/<jobid> is mounted
    // twice: over the container's /tmp, and at its own path so TMPDIR
    // (set in beforeScript, passed into the container) exists there.
    runOptions  = '-B /localscratch/soccin/oncoanalyser/$SLURM_JOB_ID:/tmp -B /localscratch/soccin/oncoanalyser/$SLURM_JOB_ID'
}
